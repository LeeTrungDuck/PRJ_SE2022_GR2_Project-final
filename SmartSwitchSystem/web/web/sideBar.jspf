<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/sideBarCss.css?v=20261006-white-headings">
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/chatWidget.css?v=1">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="sidebar">
    <div class="sidebar-header">
        <div class="um-brand">
            <span class="um-brand-icon"><i class="fa-solid fa-microchip" aria-hidden="true"></i></span>
            <div><strong>ESP32 IoT Hub</strong><span>TELEMETRY ENGINE</span></div>
        </div>

    </div>
    <!-- 2. Menu Navigation (Dùng nav-pills nav-stacked của Bootstrap 3) -->
    <div class="sidebar-menu">
        <!-- Nhóm 1 -->
        <div class="menu-group">
            <div class="menu-title">CONTROL & MONITORING</div>
            <ul class="nav nav-pills nav-stacked">
                <li class="${empty requestScope.activePage or requestScope.activePage eq 'DEVICE_CONTROL' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/MainController?action=DEVICE_CONTROL" aria-current="${empty requestScope.activePage or requestScope.activePage eq 'DEVICE_CONTROL' ? 'page' : 'false'}">
                        <i class="fa-solid fa-sliders"></i> <span>Device Control</span>
                    </a>
                </li>
                    <li class="${requestScope.activePage eq 'DEVICE_MANAGER' ? 'active' : ''}">
                        <a href="${pageContext.request.contextPath}/MainController?action=DEVICE_MANAGER" aria-current="${requestScope.activePage eq 'DEVICE_MANAGER' ? 'page' : 'false'}">
                            <i class="fa-solid fa-microchip"></i> <span>Devices &amp; Switches</span>
                        </a>
                    </li>
                <li class="${requestScope.activePage eq 'CONTROL_HISTORY' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/MainController?action=CONTROL_HISTORY" aria-current="${requestScope.activePage eq 'CONTROL_HISTORY' ? 'page' : 'false'}">
                        <i class="fa-solid fa-clock-rotate-left"></i> <span>Control History</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Nhóm 2 -->
        <div class="menu-group">

            <div class="menu-title">CONFIGURATION & SECURITY</div>
            <ul class="nav nav-pills nav-stacked">
                <c:if test="${LOGIN_USER.role ne 'VIEWER'}">
                    <li class="${requestScope.activePage eq 'PERMISSION_MANAGER' ? 'active' : ''}">
                        <a href="${pageContext.request.contextPath}/MainController?action=PERMISSION_MANAGER" aria-current="${requestScope.activePage eq 'PERMISSION_MANAGER' ? 'page' : 'false'}">
                            <i class="fa-solid fa-shield-halved"></i> <span>Device Permissions</span>
                        </a>

                    </li>
                </c:if>
                <c:if test="${LOGIN_USER.role eq 'ADMIN'}">
                    <li class="${requestScope.activePage eq 'USER_MANAGER' ? 'active' : ''}">
                        <a href="${pageContext.request.contextPath}/MainController?action=USER_MANAGER" aria-current="${requestScope.activePage eq 'USER_MANAGER' ? 'page' : 'false'}">
                            <i class="fa-solid fa-users"></i> <span>User Management</span>
                        </a>
                    </li>
                </c:if>

                <li class="${requestScope.activePage eq 'SCHEDULE_MANAGER' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/MainController?action=SCHEDULE_MANAGER" aria-current="${requestScope.activePage eq 'SCHEDULE_MANAGER' ? 'page' : 'false'}">
                        <i class="fa-solid fa-calendar-days"></i> <span>Schedules</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Nhóm 3 -->
        <div class="menu-group">
            <div class="menu-title">SYSTEM</div>
            <ul class="nav nav-pills nav-stacked">
                <li class="${requestScope.activePage eq 'ACCOUNT_MANAGER' ? 'active' : ''}">
                    <a href="${pageContext.request.contextPath}/MainController?action=ACCOUNT_MANAGER" aria-current="${requestScope.activePage eq 'ACCOUNT_MANAGER' ? 'page' : 'false'}">
                        <i class="fa-solid fa-id-card"></i> <span>Account Settings</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- 3. Footer (Thông tin User & Logout) -->
    <div class="sidebar-footer clearfix">
        <div class="pull-left media user-media">
            <div class="media-body media-middle">
                <h5 class="media-heading user-name"><c:out value="${LOGIN_USER.fullName}" /></h5>
                <span class="user-role">${LOGIN_USER.role}</span>
            </div>
        </div>

        <div class="pull-right logout-box">
            <a href="${pageContext.request.contextPath}/MainController?action=LOGOUT" class="logout-btn" title="Sign out">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>
        </div>
    </div>
</div>

<div class="ai-chat-widget" data-ai-chat>
    <section id="ai-chat-panel" class="ai-chat-panel" data-ai-chat-panel aria-hidden="true" aria-label="AI assistant chat">
        <header class="ai-chat-header">
            <div class="ai-chat-title">
                <span class="ai-chat-title-icon">
                    <img src="${pageContext.request.contextPath}/img/chatIcon.png" alt="">
                </span>
                <div>
                    <strong>Smart Switch AI</strong>
                    <span>Assistant</span>
                </div>
            </div>
            <button type="button" class="ai-chat-close" data-ai-chat-close aria-label="Close chat">&times;</button>
        </header>
        <div class="ai-chat-messages" data-ai-chat-messages aria-live="polite">
            <div class="ai-chat-message ai-chat-message--assistant">
                Xin chào! Tôi có thể hỗ trợ bạn tra cứu hệ thống Smart Switch.
            </div>
        </div>
        <form class="ai-chat-compose" data-ai-chat-form>
            <label class="sr-only" for="ai-chat-input">Your question</label>
            <textarea id="ai-chat-input" data-ai-chat-input rows="1"
                      placeholder="Ask about your smart home..." aria-label="Your question"></textarea>
            <button type="submit" class="ai-chat-send" aria-label="Send message">
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
            </button>
        </form>
    </section>
    <button type="button" class="ai-chat-launcher" data-ai-chat-open
            aria-expanded="false" aria-controls="ai-chat-panel" aria-label="Open AI chat">
        <img src="${pageContext.request.contextPath}/img/chatIcon.png" alt="Open AI chat">
    </button>
</div>

<script>window.SmartSwitchContextPath = '${pageContext.request.contextPath}';</script>
<script src="${pageContext.request.contextPath}/js/chatWidget.js?v=1"></script>
